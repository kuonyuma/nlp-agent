# Copy this file to /opt/nova-test/.env on the test server.
# Keep the resulting .env on the server only; it must never be committed.

# Required model and session configuration.
DEEPSEEK_API_KEY="REPLACE_WITH_TEST_MODEL_KEY"
NLP_AGENT_WEB_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET"

# Test image published by the develop workflow.
NOVA_IMAGE="ghcr.io/liunor/nlp-agent"
NOVA_TAG="develop"
NOVA_PULL_POLICY="always"
NOVA_WEB_HOST_PORT="18765"
NOVA_MONITOR_HOST_PORT="18766"

# Replace TEST_SERVER_IP_OR_DOMAIN with the actual internal address.
NLP_AGENT_WEB_ALLOWED_HOSTS="localhost,127.0.0.1,TEST_SERVER_IP_OR_DOMAIN"
NLP_AGENT_WEB_ALLOWED_ORIGINS="http://TEST_SERVER_IP_OR_DOMAIN:18765"
NLP_AGENT_MONITOR_ALLOWED_HOSTS="localhost,127.0.0.1,TEST_SERVER_IP_OR_DOMAIN"
NLP_AGENT_MONITOR_ALLOWED_ORIGINS="http://TEST_SERVER_IP_OR_DOMAIN:18766"

# Optional integrations. Leave empty when they are not used.
TAVILY_API_KEY=""
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="Nova-Test"
